# WHY THIS SECTION IS WRITTEN THIS WAY.
#
# A blanket `*.ts` / `*.js` / `*.txt` rule was added to keep build output and test
# scratch files out of git. Every exception had to be listed by hand, and anything
# nobody thought of was silently dropped — with no error, and invisible locally
# because the file still sits in the working directory.
#
# This was not theoretical. It removed, at various points:
#   - `src/lib/supabase/**` — the entire Supabase data layer (13 files),
#   - `src/lib/branding.ts` — the school-facts module everything imports,
#   - `src/lib/__tests__/**` — 6 guard tests,
#   - `supabase/functions/provision-teacher-account/index.ts`,
#   - `prisma/seed.ts` (recorded below) and `public/robots.txt`.
#
# The pattern is the problem, so it is gone. Each entry below is now an explicit
# DIRECTORY of source that belongs in the repository. Build output is excluded by
# its own specific directory names instead.
*.ts
!src/**/*.ts
!src/**/*.tsx
!backend/src/**/*.ts
!backend/tests/**/*.ts
!lib/**/*.ts
!components/**/*.ts
!context/**/*.ts
!hooks/**/*.ts
!types/**/*.ts
!utils/**/*.ts
!shared/**/*.ts
!services/**/*.ts
!services/**/*.tsx
!api/**/*.ts
!api/**/*.js
!supabase/functions/**/*.ts
!supabase/tests/**/*.sql
!supabase/migrations/**/*.sql
!tests/**/*.ts
!*.config.ts
!*.config.js
!scripts/**/*.js
!scripts/**/*.mjs
!scripts/**/*.ts
!scripts/**/*.sh
!package.json
!tsconfig.json
!prisma/schema.prisma
# prisma/seed.ts was silently excluded by the blanket *.ts rule above, so it
# was never committed — `npm run db:seed` (and package.json's prisma.seed
# hook) pointed at a file that only ever existed on one developer's machine,
# and failed with ERR_MODULE_NOT_FOUND everywhere else, including CI.
!prisma/seed.ts
!ddl.sql
!*.md
!pwa.d.ts
!public/
# The blanket `*.txt` rule above (meant for test_output*.txt) also silently
# swallowed this one — robots.txt was never committed, so a real git-based
# deploy (Vercel builds from a checkout, not this working directory) may
# never have shipped one at all, meaning the Sitemap: directive inside it
# never reached a crawler in production.
!public/robots.txt
!backend/prisma/
!backend/src/
!backend/config/
!backend/controllers/
!backend/middleware/
!backend/routes/
!backend/services/
!backend/utils/
!backend/package.json
!backend/tsconfig.json
!backend/.gitignore
!backend/README.md
.vercel
*.tmp*

