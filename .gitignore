.vercel-token
.claude/skills/apple-design/

# The Vercel serverless entry is hand-written source, not build output, so it
# must survive the blanket `*.js` rule above (which targets compiled output and
# legacy scripts).
!api/**/*.js

# Local Supabase personal access token, if used instead of `supabase login`.
.supabase-token

